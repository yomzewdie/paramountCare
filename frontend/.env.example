# Copy to .env.local for local development. Never commit real values.

# SERVER-ONLY. Base URL of the Cloudflare Worker API. Read at request time by
# Server Components / Route Handlers; never exposed to the browser.
# UAT: https://worker-uat.yomzewdie.workers.dev
WORKER_API_BASE_URL=http://localhost:8787

# SERVER-ONLY SECRET. Must equal the Worker's ADMIN_JWT_SECRET for the SAME
# environment exactly (the Edge middleware verifies admin session JWTs with
# it). Do NOT prefix with NEXT_PUBLIC_.
ADMIN_JWT_SECRET=

# Legacy/fallback (used by the applicant demo in lib/api.ts, and by the admin
# portal only if WORKER_API_BASE_URL is unset). Baked into client bundles at
# build time — do not put anything secret here.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
