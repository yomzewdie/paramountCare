/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-21",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS_BUCKET",
			"bucket_name": "paramountcare-uploads-dev",
			"preview_bucket_name": "paramountcare-uploads-dev"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paramountcare-db-dev",
			"database_id": "207eaa94-b8e9-44f7-ba9c-2ccc39a5a5a4",
			"migrations_dir": "migrations"
		}
	],
	// "development" here — this is still the single pre-environment-split
	// deployment target from ADR-013 (docs/ARCHITECTURE_DECISION_RECORDS.md),
	// not yet a real "production". When that split happens, the production
	// environment's own wrangler.jsonc block MUST override this to
	// "production" — see routes/invites.ts's use of it as a fail-safe against
	// ever emailing an applicant a localhost invitation link.
	"vars": { "ENVIRONMENT": "development" },
	// Real, isolated UAT environment (mobile UAT phase). Deploys as a
	// separate Worker script ("worker-uat", Wrangler's standard
	// {name}-{env} convention) against its own D1 database and R2 bucket —
	// never the "development" resources above. Binding names are
	// deliberately identical to the top-level config (DB / UPLOADS_BUCKET)
	// so no application code needs to change per-environment.
	"env": {
		"uat": {
			"name": "worker-uat",
			"r2_buckets": [
				{
					"binding": "UPLOADS_BUCKET",
					"bucket_name": "paramountcare-uploads-uat",
					"preview_bucket_name": "paramountcare-uploads-uat"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "paramountcare-db-uat",
					"database_id": "69163f6c-21ea-46d6-9c4d-68395b5f753b",
					"migrations_dir": "migrations"
				}
			],
			// Real, deployed worker-uat URL. No HTML page is served at this
			// path — UAT invite testing deliberately does not depend on
			// tapping the emailed link (Universal Links/App Links are out
			// of scope this phase); testers copy the raw token out of the
			// real invitation email itself and paste it into the app's
			// existing manual invite-token field on Create Account.
			"vars": { "ENVIRONMENT": "uat", "APPLICANT_INVITE_BASE_URL": "https://worker-uat.yomzewdie.workers.dev/register" }
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}