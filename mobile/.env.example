# Copy to .env (gitignored) for local development. None of these are
# secrets — see README.md "Environments" for what's safe to expose
# client-side (everything here) vs. what must never leave the server (Worker
# secrets like ADMIN_JWT_SECRET / EMAIL_VERIFICATION_SECRET — none of those
# belong in this file or anywhere in the mobile app).

# Defaults to http://localhost:8787 (the local Worker dev server) if unset —
# fine for development, but see app.config.ts: uat/production builds REQUIRE
# this to be set explicitly (via EAS environment variables), not committed here.
API_BASE_URL=http://localhost:8787

# Leave unset until `eas init` has actually been run for this project.
# EAS_PROJECT_ID=
# EAS_OWNER=
