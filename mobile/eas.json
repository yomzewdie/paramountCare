{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EAS_PROJECT_ID": "760d3c4c-d127-415f-b7b2-22c4bbc2dad8",
        "EAS_OWNER": "yomzewdie"
      }
    },
    "uat": {
      "distribution": "internal",
      "channel": "uat",
      "pnpm": "9.15.9",
      "env": {
        "APP_ENV": "uat",
        "EAS_PROJECT_ID": "760d3c4c-d127-415f-b7b2-22c4bbc2dad8",
        "EAS_OWNER": "yomzewdie",
        "API_BASE_URL": "https://worker-uat.yomzewdie.workers.dev"
      }
    },
    "uat-testflight": {
      "extends": "uat",
      "distribution": "store",
      "autoIncrement": true
    },
    "uat-android": {
      "extends": "uat",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EAS_PROJECT_ID": "760d3c4c-d127-415f-b7b2-22c4bbc2dad8",
        "EAS_OWNER": "yomzewdie"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
    "uat-testflight": {}
  }
}
